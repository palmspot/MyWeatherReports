{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy Weather App",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\scripts\\deploy-weather.ps1",
                "-FilePath", "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy to FreeBSD Jail",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "cd \"${workspaceFolder}\" && ./deploy_to_jail.sh --once"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}