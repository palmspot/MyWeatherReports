{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy Weather App",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\scripts\\deploy-weather.ps1",
                "-FilePath", "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}